{
  "name": "autumn-syntax-icon",
  "publisher": "FabianRiveraMorales",
  "displayName": "Autumn Framework Support",
  "description": "Soporte de sintaxis, resaltado, snippets e íconos para archivos .atm",
  "version": "1.2.0",
  "license": "MIT",
  "icon": "autumn-icon-controller.png",
  "keywords": [
    "autumn",
    "autumn-framework",
    "atm",
    "typescript",
    "snippets",
    "icons"
  ],
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "autumn-service",
        "aliases": [
          "Autumn Service",
          "autumn-service"
        ],
        "extensions": [
          ".service.atm",
          ".services.atm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./autumn-icon-service.png",
          "dark": "./autumn-icon-service.png"
        }
      },
      {
        "id": "autumn",
        "aliases": [
          "Autumn",
          "autumn"
        ],
        "extensions": [
          ".controller.atm",
          ".atm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./autumn-icon-controller.png",
          "dark": "./autumn-icon-controller.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "autumn",
        "scopeName": "source.autumn",
        "path": "./syntaxes/autumn.tmLanguage.json"
      },
      {
        "language": "autumn-service",
        "scopeName": "source.autumn",
        "path": "./syntaxes/autumn.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "autumn",
        "path": "./snippets/snippets.json"
      },
      {
        "language": "autumn-service",
        "path": "./snippets/snippets.json"
      }
    ]
  }
}