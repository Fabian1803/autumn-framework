import { Controller, View, Style } from 'autumn-js';

@Controller
export class Login {
    @View
    public html() {
        <div class="login-container">
            <div class="login-card">
                <h2>🍁 Autumn Warehouse System</h2>
                <p class="subtitle">Ingrese sus credenciales de acceso</p>
                <hr class="divider" />
                <form class="login-form" onsubmit="autumnPerformLogin(event)">
                    <div class="form-group">
                        <label>Usuario</label>
                        <input type="text" placeholder="admin" value="admin" id="username" />
                    </div>
                    <div class="form-group">
                        <label>Contraseña</label>
                        <input type="password" placeholder="••••••••" value="123456" id="password" />
                    </div>
                    <button type="submit" class="btn-login">🚀 Iniciar Sesión</button>
                </form>
            </div>
        </div>
    }

    @Style
    public css() {
        .login-container {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
            font-family: sans-serif;
        }
        .login-card {
            background: white;
            border: 1px solid #e1e8ed;
            border-radius: 12px;
            padding: 30px;
            width: 100%;
            max-width: 380px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
            text-align: center;
        }
        .login-card h2 {
            color: #d35400;
            margin-top: 0;
            font-size: 20px;
        }
        .subtitle {
            color: #7f8c8d;
            font-size: 14px;
            margin-bottom: 20px;
        }
        .divider {
            border: 0;
            height: 1px;
            background: #eee;
            margin-bottom: 20px;
        }
        .login-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
            text-align: left;
        }
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .form-group label {
            font-size: 13px;
            font-weight: 600;
            color: #34495e;
        }
        .form-group input {
            padding: 10px 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 14px;
            outline: none;
        }
        .form-group input:focus {
            border-color: #e67e22;
        }
        .btn-login {
            display: block;
            background: #e67e22;
            color: white;
            padding: 12px;
            border-radius: 6px;
            border: none;
            cursor: pointer;
            text-align: center;
            font-weight: bold;
            font-size: 15px;
            margin-top: 10px;
            transition: background 0.2s ease;
        }
        .btn-login:hover {
            background: #d35400;
        }
    }
}