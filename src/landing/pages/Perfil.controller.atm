    public html(){
        <section class="page-card profile-card">
            <h2>👤 Datos de Perfil</h2>
            <p><strong>Usuario:</strong> Administrador Autumn</p>
            <p><strong>Rol:</strong> Developer Lead 🍁</p>
        </section>
    }

    @Style
