import { Router, mapping } from 'autumn-js';
import { AuthInterceptor } from './src/security/Auth.interceptor.js';
import { LoggingInterceptor } from './src/security/Logging.interceptor.js';

@Router
export class ApplicationRoutes {
    @mapping("/")
    public component Login('./src/login/login.controller.atm') {};
    
    @mapping("/landing")
    public component Landing('./src/landing/Landing.controller.atm') {
        children {
            @mapping('/')
            public component Home('./src/landing/pages/Home.controller.atm') {};

            @mapping('/perfil')
            public component Perfil('./src/landing/pages/Perfil.controller.atm') {};
        }
    };

    @mapping("/dashboard") 
    private component Dashboard('./src/dashboard/Dashboard.controller.atm') {  
        AuthInterceptor, 
        LoggingInterceptor
    };

    @mapping('/profile')
    private component Profile('./src/profile/Profile.controller.atm') { 
        AuthInterceptor 
    };

    @mapping('/user/:id')
    public component UserDetail('./src/user/User.controller.atm') {};
}
